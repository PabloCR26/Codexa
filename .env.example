# Aplicación
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173
PUBLIC_URL=http://localhost:4000

# Trabajos simultaneos del worker (bajo, para respetar limites de tasa)
WORKER_CONCURRENCY=5

# PostgreSQL y Redis (coinciden con docker-compose.yml)
POSTGRES_PORT=5433
REDIS_PORT=6379
DATABASE_URL=postgresql://flowhub:flowhub@127.0.0.1:5433/flowhub?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Generar ambos valores siguiendo las instrucciones del README
SESSION_SECRET=replace-with-a-long-random-value
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback

# OAuth y webhooks GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/oauth/github/callback
GITHUB_WEBHOOK_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
