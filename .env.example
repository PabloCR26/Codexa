# Aplicación
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173
PUBLIC_URL=http://localhost:4000

# PostgreSQL y Redis (coinciden con docker-compose.yml)
DATABASE_URL=postgresql://flowhub:flowhub@localhost:5432/flowhub?schema=public
REDIS_URL=redis://localhost:6379

# Generar ambos valores siguiendo las instrucciones del README
SESSION_SECRET=replace-with-a-long-random-value
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

# OAuth Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback

# OAuth y webhooks GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/api/oauth/github/callback
GITHUB_WEBHOOK_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
